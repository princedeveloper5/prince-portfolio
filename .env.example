# Copy this file to `.env` (project root) and fill in real values.
# `.env` is git-ignored — never commit real credentials.

# --- SMTP (required for email notifications) ---
# Gmail: host smtp.gmail.com, port 587, and a Google App Password
# (Google Account → Security → 2-Step Verification → App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
# Optional. Defaults to SMTP_USER. Must be a real Gmail address for Gmail.
SMTP_FROM=your_email@gmail.com

# --- Where notifications are delivered ---
CONTACT_TO=your_email@gmail.com

# --- Optional server settings ---
# PORT=5000
# APP_URL=https://your-domain.com
# JWT_SECRET=change-me-in-production

# --- Optional persistent hosted data (required on Render's free service) ---
# TURSO_DATABASE_URL=libsql://your-database-yourname.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_keep-this-server-only
# SUPABASE_STORAGE_BUCKET=portfolio-uploads
