# Copy this file to `.env` and fill in private values. Never commit `.env`.

# Optional email notifications (SMTP_HOST, SMTP_USER, and SMTP_PASS are required).
# For Gmail, use an App Password rather than your regular account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=your_email@gmail.com
CONTACT_TO=your_email@gmail.com

# Local and hosted backend configuration
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace_with_a_new_turso_auth_token
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace_with_a_new_supabase_secret_key
SUPABASE_STORAGE_BUCKET=portfolio-uploads

# Admin account and server settings
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=use_a_private_password_of_at_least_12_characters
ADMIN_NAME=Portfolio Admin
# Render generates JWT_SECRET from render.yaml. Set a private value for local server use if desired.
# JWT_SECRET=replace_with_a_long_random_secret
# APP_URL=https://your-domain.com
# PORT=5000
